[gd_resource type="Resource" script_class="RecipeDef" format=3]

[ext_resource type="Script" path="res://scripts/kitchen/recipe_part_def.gd" id="1_part"]
[ext_resource type="Script" path="res://scripts/kitchen/recipe_def.gd" id="2_def"]
[ext_resource type="Texture2D" path="res://assets/art/dishes/Nasi-Tempe.png" id="3_icon"]

[sub_resource type="Resource" id="Resource_p1"]
script = ExtResource("1_part")
ingredient_id = &"beras"
required_state = 2

[sub_resource type="Resource" id="Resource_p2"]
script = ExtResource("1_part")
ingredient_id = &"tempe"

[resource]
script = ExtResource("2_def")
recipe_id = &"nasi_tempe"
display_name = "Nasi Tempe"
icon_key = &"nasi_tempe"
icon = ExtResource("3_icon")
description = "Masak nasi, goreng tempe, lalu satukan di piring."
required_parts = Array[ExtResource("1_part")]([SubResource("Resource_p1"), SubResource("Resource_p2")])
